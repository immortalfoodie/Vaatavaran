{
  "name": "vaatavaran",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An explainable urban air quality assistant for families and communities",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 --test-coverage-include=lib/** --test-coverage-include=public/cities.js --test-coverage-include=public/engine.js --test-coverage-include=public/guard.js --test-coverage-include=public/local-guide.js --test-coverage-include=public/time.js --test-coverage-include=public/aqi-scales.js --test-coverage-include=public/format.js --test-coverage-include=public/theme.js --test-coverage-include=public/planner.js --test-coverage-include=public/clean-room.js --test-coverage-include=public/history.js --test-coverage-include=server.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "verify": "npm run check && npm run test:coverage && node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
